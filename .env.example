# ====================================================================
# SpendLog V2 — Örnek Ortam Değişkenleri (.env.example)
# ====================================================================
# Bu dosyayı '.env' olarak kopyalayıp kendi değerlerinizi girebilirsiniz:
# cp .env.example .env

# --- Veritabanı & Altyapı ---
MSSQL_SA_PASSWORD=SpendLog2026!StrongPass
REDIS_HOST=spendlog-redis
REDIS_PORT=6379

# --- Güvenlik & JWT ---
JWT_SECRET_KEY=SpendLog_Default_Development_Secret_Key_Minimum_32_Chars!

# --- Telegram Entegrasyonu ---
# BotFather'dan aldığınız bot tokenı:
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# --- Servis URL'leri ---
NEXT_PUBLIC_API_URL=http://localhost:5007
NEXT_PUBLIC_SCRAPER_URL=http://localhost:8000
